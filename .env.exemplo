# Copie para .env e preencha:  cp .env.exemplo .env && chmod 600 .env
# Sem aspas e sem espaços em volta do "=". Cada valor numa linha só.

# Binance: chave SOMENTE LEITURA ("Enable Reading" apenas; sem trade, sem saque),
# restrita ao IP do servidor.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Telegram: token do @BotFather e o seu ID (descubra com o @userinfobot).
# Mande /start para o bot antes do primeiro uso.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
